# ── MQTT ──────────────────────────────────────────
MQTT_USER=thguard-backend
MQTT_PASSWORD=sua_senha_mqtt
MQTT_BROKER=mqtt://mosquitto:1883

# ── InfluxDB ──────────────────────────────────────
INFLUX_URL=http://influxdb:8086
INFLUX_TOKEN=seu_token_influxdb
INFLUX_ORG=iot
INFLUX_BUCKET=sensores
INFLUX_USER=admin
INFLUX_PASSWORD=sua_senha_influx

# ── MariaDB ───────────────────────────────────────
DB_ROOT_PASSWORD=sua_senha_root
DB_USER=thguard
DB_PASSWORD=sua_senha_db
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=thguard

# ── Backend ───────────────────────────────────────
JWT_SECRET=gere_uma_chave_secreta_aleatoria_aqui
PORT=3001
TZ=America/Sao_Paulo

# CORS — origens permitidas, separadas por virgula.
# Deve incluir o endereco pelo qual o painel e acessado,
# senao o login retorna erro 500 (origem bloqueada).
# Ex. local:      http://localhost:8081
# Ex. rede local: http://10.10.0.209:8081
ALLOWED_ORIGINS=http://localhost:8081

# Admin padrao (trocar apos primeiro acesso)
ADMIN_PASSWORD=troque_esta_senha_no_primeiro_acesso
