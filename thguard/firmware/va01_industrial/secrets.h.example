#pragma once
// Copie para secrets.h e preencha. secrets.h esta no .gitignore: NUNCA commitar.

// Mesmo usuario MQTT dos sensores TH-GUARD (mosquitto/passwd no servidor)
#define MQTT_USER   "thguard"
#define MQTT_PASS   "TROQUE_AQUI"

// Senha da rede do portal "VA01-Setup-XXXX" (minimo 8 caracteres)
#define AP_PASS     "TROQUE_AQUI"

// Login do portal web do ESP (http://192.168.4.1 ou http://<ip-do-sensor>)
#define PORTAL_USER "admin"
#define PORTAL_PASS "TROQUE_AQUI"

// Chave PUBLICA da atualizacao pela rede (OTA). Copie do painel do TH-GUARD:
// Painel de administracao > Firmware > "Chave publica para o secrets.h".
// O ESP so instala firmware assinado pela chave privada que fica no servidor.
#define OTA_PUBKEY \
  "-----BEGIN PUBLIC KEY-----\n" \
  "COLE_AQUI_A_PRIMEIRA_LINHA_DA_CHAVE\n" \
  "COLE_AQUI_A_SEGUNDA_LINHA_DA_CHAVE\n" \
  "-----END PUBLIC KEY-----\n"
