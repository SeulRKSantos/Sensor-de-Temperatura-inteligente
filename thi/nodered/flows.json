    {
        "id": "e7168d3c1fe7c122",
        "type": "function",
        "z": "1587388e210f39bb",
        "name": "Formatar para InfluxDB",
        "func": "// Se o payload chegou como string, converte para objeto\nlet dados = msg.payload;\nif (typeof dados === \"string\") {\n    try { dados = JSON.parse(dados); }\n    catch (e) { node.error(\"Payload nao e JSON valido: \" + dados); return null; }\n}\n\n// Garante que temperatura seja número\nconst temp = parseFloat(dados.t);\nif (isNaN(temp)) {\n    node.error(\"Temperatura invalida: \" + dados.t);\n    return null;\n}\n\n// Formato esperado pelo \"influxdb out\" (nao batch):\n// msg.payload = { campo1: valor, campo2: valor }\n// E as tags vao em msg.tags\nmsg.payload = {\n    valor: temp,\n    falha: dados.f ? 1 : 0\n};\n\nmsg.tags = {\n    sensor_id: String(dados.id || \"desconhecido\")\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 390,
        "y": 980,
