    {
        "id": "b61d896740b66915",
        "type": "function",
        "z": "83e1d8e1911a0e33",
        "name": "Registrar Timestamp",
        "func": "let sensores = flow.get('sensores') || {};\n\nconst partes = msg.topic.split('/');\nif (partes.length >= 2) {\n    const id = partes[1];\n    sensores[id] = Date.now();\n    flow.set('sensores', sensores);\n}\n\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 300,
        "wires": [
            []
        ]
    },
    {
        "id": "20e50f2e7ae4056e",
        "type": "function",
        "z": "83e1d8e1911a0e33",
        "name": "Checar Offline",
        "func": "// ── Sensores monitorados ──────────────────────────────────\n// Adicione novos sensores aqui conforme forem instalados\nconst SENSORES = ['VA01'];\nconst TIMEOUT_MS = 15000;\n\n// ─────────────────────────────────────────────────────────\nconst sensores = flow.get('sensores') || {};\nconst agora    = Date.now();\n\nconst offline = [];\nconst online  = [];\n\nSENSORES.forEach(id => {\n    const ultima = sensores[id];\n    if (!ultima) {\n        offline.push({ id, motivo: 'nunca_visto' });\n    } else if ((agora - ultima) > TIMEOUT_MS) {\n        const s = Math.floor((agora - ultima) / 1000);\n        offline.push({ id, motivo: 'timeout', segundos: s });\n    } else {\n        online.push(id);\n    }\n});\n\n// Gravar status de cada sensor no InfluxDB\nconst statusMsgs = SENSORES.map(id => ({\n    topic:   `monitoramento/${id}/online`,\n    payload: JSON.stringify({\n        id:     id,\n        online: online.includes(id),\n        ts:     Math.floor(agora / 1000)\n    }),\n    qos:    1,\n    retain: true\n}));\n\n// Log no debug\nif (offline.length > 0) {\n    const nomes = offline.map(s =>\n        `${s.id} (${s.motivo === 'nunca_visto' ? 'nunca visto' : s.segundos + 's sem resposta'})`\n    ).join(', ');\n    node.warn(`OFFLINE: ${nomes}`);\n} else {\n    node.log(`Todos online: ${online.join(', ')}`);\n}\n\n// Saída 1: alerta de offline (só dispara se houver offline)\n// Saída 2: status individual para gravar no InfluxDB\nconst alerta = offline.length > 0 ? {\n    payload: { offline, online, ts: new Date().toISOString() }\n} : null;\n\nreturn [alerta, ...statusMsgs];",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
